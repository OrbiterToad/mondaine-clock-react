{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./bongo",
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "jsx": "react-jsx"
  },
  "include": [
    "src/lib/**/*"
  ],
  "exclude": [
    "src/lib/**/*.test.ts",
    "src/lib/**/*.test.tsx",
    "src/lib/**/*.spec.ts",
    "src/lib/**/*.spec.tsx"
  ]
}
