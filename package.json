{
  "name": "mondaine-clock-react",
  "version": "2.0.0",
  "description": "Unofficial implementation of the official Swiss station clock by Mondaine",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "react-scripts start",
    "test": "react-scripts test",
    "build": "rm -rf dist bongo && tsc --project tsconfig.build.json && babel bongo --out-dir dist --copy-files --ignore '**/*.d.ts' && rm -rf bongo",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/cli": "^7.23.0",
    "@babel/preset-env": "^7.28.6",
    "@babel/preset-react": "^7.23.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "@types/jest": "^27.5.2",
    "@types/react": "^18.2.25",
    "@types/react-test-renderer": "^18.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-scripts": "5.0.1",
    "react-test-renderer": "^18.0.3",
    "typescript": "^4.9.5"
  },
  "peerDependencies": {
    "react": ">=16.0.1",
    "react-dom": ">=16.0.1"
  }
}
